%% O-RAN Agent Harness for Cloud RAN Day-2, fully detailed closed-loop architecture (v4)
%% Companion to: docs/title_and_abstract_final.txt
%% v4 changes vs v3:
%%   replaced generic LiteLLM cluster with Unified LLM Inference Client showing the three
%%     providers supported by the bench: Anthropic Claude, OpenAI GPT, and
%%     OpenAI-compatible vLLM such as Red Hat OpenShift AI plus the ORAN_LLM_MODE env gate
%%   added scenario E (NIC firmware) explicit edges: Metal3 -> HostFirmwareComponents
%%     -> BareMetalHost -> BMC -> Redfish UpdateService.SimpleUpdate -> NIC firmware
%%   added scenario D verdict divergence: linuxptp reports software_ok while NIC reports
%%     hardware_anomaly on tx_hwtstamp_timeouts; the Hardware Agent overrides the surface signal
%%   added durable Trace JSONL persistence layer (shared_trace/*.jsonl); every cognitive
%%     stage appends, every audit event appends, every routing decision appends
%%   added TMF921 companion intent emission node for dual-route node_firmware actions
%% v3 changes vs v2: added Hardware Domain Agent + mcp-hardware; added Knowledge Base (RAG)
%%                   shared across agents and Router; added Root Cause Analysis artifact
%%                   between agents and Router; expanded Gateway security profile label.
flowchart TB

    %% ============== UPSTREAM RAN CONTEXT ==============
    subgraph RanUpstream["RAN Upstream Context"]
        direction LR
        GPS["GNSS / GPS Antenna<br/>(disciplined source)"]:::external
        GM["PTP Grandmaster<br/>(T-GM, G.8275.1 profile,<br/>runs ts2phc + ptp4l,<br/>ITU-T compliant)"]:::external
        BC["Boundary Clock (T-BC)<br/>(deployment-specific)"]:::external
        RU["O-RAN Radio Unit (O-RU)<br/>(physical radio + antenna)"]:::external
        GPS --> GM
        GM --> BC
    end

    %% ============== 5G CORE (downstream context) ==============
    subgraph Core5G["5G Core (downstream of vCU)"]
        direction LR
        UPF["User Plane Function (UPF)<br/>(N3 endpoint)"]:::external
        AMF["AMF / SMF"]:::external
        UPF --- AMF
    end

    %% ============== SMO / DOMAIN ORCHESTRATOR ==============
    SMO["Partner SMO / Domain Orchestrator<br/>(Ericsson SMO, Amdocs, Nokia, Mavenir, ZTE)<br/>Service-layer remediation owner"]:::smo

    %% ============== AGENT HARNESS ==============
    subgraph Harness["Agent Harness (Cloud RAN Day-2), Day-2 reasoning + remediation routing"]
        direction TB

        subgraph GatewayLayer["Agentic Gateway over MCP"]
            Gateway["Agentic Gateway<br/>(O-RAN CloudEvents inbound,<br/>vendor-private tool exposure,<br/>mTLS + OAuth2 + IP allowlist)"]:::gateway
            McpPlat["mcp-platform<br/>(FastMCP, stdio)<br/>ptp4l + driver + host config tools"]:::mcp
            McpRan["mcp-ran<br/>(FastMCP, stdio)<br/>cell + PM + RAN param tools"]:::mcp
            McpHw["mcp-hardware<br/>(FastMCP, stdio)<br/>NIC PHC introspection /<br/>BMC Redfish / CPU perf counters"]:::mcp
            McpOcloud["mcp-ocloud<br/>(FastMCP, stdio)<br/>O2 IMS Inventory / Alarms /<br/>apply (gated)"]:::mcp
            Gateway --> McpPlat
            Gateway --> McpRan
            Gateway --> McpHw
            Gateway --> McpOcloud
        end

        subgraph AgentLayer["Domain Agents (LangGraph nodes)"]
            PlatA["Platform Agent<br/>(diagnoses host / driver /<br/>PTP stack faults)"]:::agent
            RanA["RAN Domain Agent<br/>(diagnoses cell / PM /<br/>RAN parameter faults)"]:::agent
            HwA["Hardware Domain Agent<br/>(diagnoses NIC firmware / PHC /<br/>BMC / CPU / HW timestamping)"]:::agent
        end

        subgraph KbLayer["Knowledge Base (RAG)"]
            KB["Knowledge Base (RAG)<br/>NOC troubleshooting playbooks,<br/>case history, SID context<br/>(maps to TMF GB922 +<br/>vendor RAG surfaces)"]:::kb
        end

        subgraph RouterLayer["Remediation Router"]
            RCA["Root Cause Analysis<br/>(cross-domain evidence chain,<br/>structured findings per agent)"]:::artifact
            Taxonomy["taxonomy.yaml<br/>(O-RAN WG6 resource model;<br/>~20 entries)"]:::config
            Router["Remediation Router<br/>deterministic classification<br/>+ LLM-assist on ambiguous edges"]:::router
            Proposal["RemediationProposal<br/>(structured dataclass:<br/>target_layer, evidence,<br/>action, confidence)"]:::artifact
            RCA --> Router
            Taxonomy -- "lookup" --> Router
            Router --> Proposal
        end

        subgraph GuardLayer["Guardrail Contract Layer (LLM-free, deterministic)"]
            Guard["Guardrail Engine<br/>(operator-harness<br/>co-authorization)"]:::guard
            Rules["guardrails.yaml<br/>(dry-run default,<br/>blast-radius caps,<br/>HITL action allowlist)"]:::config
            Audit["Audit Sink<br/>(JSONL file +<br/>TMF688-shaped events)"]:::artifact
            Rules -- "policy" --> Guard
            Guard --> Audit
        end

        subgraph LlmLayer["Unified LLM Inference Client (env-gated by ORAN_LLM_MODE, consumed by agents + router)"]
            InfClient["Inference Client<br/>(5G_O-RAN_SIM/llm/inference_client.py)<br/>provider selection by env;<br/>explicit unavailable result if unconfigured"]:::llm
            Claude["Anthropic Claude<br/>(ANTHROPIC_API_KEY)"]:::llmBackend
            GPT["OpenAI GPT<br/>(OPENAI_API_KEY)"]:::llmBackend
            VLLM["vLLM<br/>(OpenShift AI or other<br/>on-prem OpenAI-compatible endpoint)"]:::llmBackend
            InfClient --> Claude
            InfClient --> GPT
            InfClient --> VLLM
        end

        subgraph TraceLayer["Durable evidence layer (shared_trace JSONL)"]
            TraceFile["Trace JSONL<br/>(5G_O-RAN_SIM/shared_trace/*.jsonl)<br/>append-only per scenario;<br/>verify gate replays from these"]:::trace
        end

        McpPlat --> PlatA
        McpRan --> RanA
        McpHw --> HwA
        McpOcloud -.inventory + alarm context.-> PlatA
        PlatA --> RCA
        RanA --> RCA
        HwA --> RCA
        Proposal --> Guard
        KB -.playbook lookup.-> PlatA
        KB -.playbook lookup.-> RanA
        KB -.playbook lookup.-> HwA
        KB -.SID context.-> Router
        PlatA -.LLM reasoning<br/>(only when ORAN_LLM_MODE=live).-> InfClient
        RanA -.LLM reasoning.-> InfClient
        HwA -.LLM reasoning.-> InfClient
        Router -.LLM-assist<br/>(ambiguous_path only).-> InfClient

        %% Trace persistence: every cognitive stage appends
        PlatA -. append finding .-> TraceFile
        RanA -. append finding .-> TraceFile
        HwA -. append finding .-> TraceFile
        RCA -. append .-> TraceFile
        Router -. append routing decision .-> TraceFile
        Proposal -. append .-> TraceFile
        Audit -. append .-> TraceFile
    end

    %% Companion intent emission for dual-route node_firmware actions (scenario E)
    CompanionIntent["TMF921 Companion Intent<br/>(scenario E; fires when<br/>action.type == apply_metal3_firmware,<br/>regardless of cell count)"]:::artifact

    %% ============== HUB CLUSTER (O-CLOUD CONTROL PLANE) ==============
    subgraph Hub["Red Hat O-Cloud Control Plane (Hub OpenShift Cluster)"]
        direction TB
        O2IMS["O-Cloud Manager<br/>O2 IMS API<br/>(openshift-kni/oran-o2ims)<br/>Inventory + Cluster + Alarms"]:::ocloud
        TALM["Topology Aware<br/>Lifecycle Manager (TALM)<br/>ZTP rollout sequencing"]:::hubop
        ArgoCD["OpenShift GitOps<br/>(ArgoCD)"]:::hubop
        ACM["Advanced Cluster Management<br/>(RHACM, multi-cluster)"]:::acm
        Git["Git repository<br/>(ClusterTemplate +<br/>PolicyGenTemplate)"]:::artifact

        O2IMS --> TALM
        O2IMS --> ArgoCD
        TALM --> ACM
        ArgoCD --> Git
        Git --> ACM
    end

    %% ============== OBSERVABILITY (adjacent to harness) ==============
    subgraph Obs["Observability Stack"]
        direction LR
        Prom["Prometheus / Thanos"]:::obs
        Graf["Grafana"]:::obs
        Loki["Loki (logs)"]:::obs
        Otel["OpenTelemetry collector"]:::obs
        Prom --> Graf
        Loki --> Graf
        Otel --> Prom
        Otel --> Loki
    end

    %% ============== SPOKE CLUSTER ==============
    subgraph Spoke["Managed OpenShift Cluster (Cloud RAN Edge Site)"]
        direction TB

        subgraph SpokeOps["Cluster Operators (managed by hub)"]
            direction LR
            MCO["Machine Config<br/>Operator (MCO)"]:::mco
            KMM["Kernel Module<br/>Management (KMM)"]:::kmm
            PTPOp["PTP Operator"]:::ptpop
            NTO["Node Tuning Operator<br/>(PerformanceProfile,<br/>realtime kernel)"]:::nto
            Metal3["Metal3<br/>(BareMetalHost,<br/>HostFirmwareComponents)"]:::metal3
            SRIOV["SR-IOV Network<br/>Operator"]:::sriov
            NFD["NodeFeatureDiscovery<br/>(NFD)"]:::nfd
        end

        subgraph SpokeNet["Cluster Networking"]
            direction LR
            OVNK["OVN-Kubernetes<br/>(primary CNI)"]:::netcni
            Multus["Multus<br/>(secondary networks)"]:::netcni
        end

        subgraph Worker["worker-ran-XX (RHCOS bare-metal node)"]
            direction TB

            subgraph KubeNode["Kubernetes Node Plane"]
                Kubelet["kubelet"]:::kube
                CRIO["CRI-O runtime"]:::kube
                TopoMgr["Topology Manager<br/>+ CPU Manager (pinned)<br/>+ HugePages (1G)"]:::kube
            end

            subgraph WorkloadPods["RAN Workload Pods (3GPP / O-RAN)"]
                direction LR
                VDU["O-RAN vDU / gNB-DU<br/>(L1/L2 RAN workload)<br/>uses DPDK + SR-IOV VFs<br/>consumes PTP timing (TAI)"]:::vdu
                VCU["O-RAN vCU / gNB-CU<br/>(L3 RAN workload)"]:::vdu
                VDU -- "F1 interface<br/>(midhaul, SCTP / GTP-U)" --> VCU
            end

            subgraph PtpPods["PTP Stack Pods (managed by PTP Operator)"]
                LinuxPtp["linuxptp-daemon pod<br/>ptp4l + phc2sys<br/>(Boundary / Ordinary Clock)<br/>G.8275.1 profile"]:::daemon
                CEProxy["Cloud Event Proxy<br/>(sidecar in same pod)<br/>O-RAN CloudEvents publisher"]:::proxy
            end

            subgraph HostOS["RHCOS Host OS"]
                Kernel["Linux kernel<br/>(realtime patches optional)"]:::kernel
                Driver["NIC driver<br/>(ice / mlx5_core / iavf)<br/>kernel module"]:::driver
                FwLldp["fw-lldp-agent<br/>(host service,<br/>Scenario A target)"]:::hostsvc
            end

            subgraph Hardware["Bare-metal hardware (NUMA-aware)"]
                NIC["Intel E810 NIC<br/>(or Mellanox CX-6 DX)<br/>PHC (PTP Hardware Clock)<br/>SR-IOV capable<br/>hardware timestamping"]:::hw
                BMC["BMC<br/>(Redfish endpoint,<br/>OOB management)"]:::bmc
                CPU["CPU sockets<br/>(NUMA-pinned)<br/>+ RAM + NVMe"]:::cpu
            end

            VDU -- "clock_gettime<br/>(CLOCK_TAI)" --> Kernel
            VDU -- "DPDK userspace<br/>networking" --> NIC
            LinuxPtp -- "PHC adjust + timestamping<br/>(clock_adjtime,<br/>SIOCSHWTSTAMP ioctl)" --> Kernel
            LinuxPtp -- "state notifications<br/>(UDS / log parsing)" --> CEProxy
            Kernel --> Driver
            FwLldp -. "LLDP TX contention<br/>(fault in Scenario A)" .-> NIC
            Driver -- "HW register config<br/>+ DMA descriptors" --> NIC
            Kubelet --> CRIO
            CRIO --> VDU
            CRIO --> VCU
            CRIO --> LinuxPtp
            TopoMgr -- "NUMA + CPU pinning" --> VDU
        end
    end

    %% ============== EXTERNAL RAN FLOWS ==============
    GM == "PTP packets<br/>(G.8275.1)" ==> NIC
    BC -. "boundary clock<br/>(if deployed)" .-> NIC
    VDU == "Open Fronthaul<br/>eCPRI (O-RAN WG4)<br/>U/C/S/M planes" ==> RU
    VCU == "N3 / GTP-U<br/>(backhaul)" ==> UPF

    %% ============== OBSERVATION CHANNEL UP ==============
    CEProxy == "O-RAN CloudEvents<br/>(WG6 Cloud Notifications<br/>over CNCF CloudEvents 1.0)" ==> Gateway
    LinuxPtp -. "PM counters<br/>+ ptp4l logs" .-> Prom
    Audit -. "TMF688 events<br/>(production: Kafka/AMQ)" .-> Otel

    %% ============== ROUTING DECISIONS ==============
    Router == "service-layer<br/>(TMF921-style intent)" ==> SMO
    Router == "infra-layer<br/>via O2 IMS" ==> O2IMS
    Router == "dual-route fan-out<br/>(scenario E: companion intent UP<br/>while Metal3 push fires DOWN)" ==> CompanionIntent
    CompanionIntent ==> SMO

    %% ============== HUB -> SPOKE POLICY PROPAGATION ==============
    ACM -- "policy propagation" --> MCO
    ACM -- "policy propagation" --> KMM
    ACM -- "policy propagation" --> PTPOp
    ACM -- "policy propagation" --> NTO
    ACM -- "policy propagation" --> Metal3
    ACM -- "policy propagation" --> SRIOV
    ACM -- "policy propagation" --> NFD

    %% ============== OPERATORS DELIVER TO WORKER ==============
    MCO == "Scenario A:<br/>MachineConfig<br/>(mask fw-lldp-agent.service)" ==> FwLldp
    KMM == "Scenario A-prime:<br/>Module CR<br/>(swap ice 1.11.x -> 1.13.7+)" ==> Driver
    Metal3 == "Scenario E:<br/>HostFirmwareComponents +<br/>BareMetalHost apply<br/>(Intel E810 PF0 firmware,<br/>9.8 MB blob)" ==> BMC
    PTPOp -- "PtpConfig CR<br/>(ptp4l.conf, profile)" --> LinuxPtp
    PTPOp -- "deploys daemon set" --> LinuxPtp
    PTPOp -- "deploys sidecar" --> CEProxy
    NTO -- "PerformanceProfile<br/>(TopoMgr, CPU pinning,<br/>HugePages, RT kernel)" --> TopoMgr
    BMC == "Scenario E:<br/>Redfish UpdateService.SimpleUpdate<br/>(DSP0266, NIC firmware push,<br/>task lifecycle: Pending -> Running -> Completed)" ==> NIC
    BMC -- "OOB mgmt plane" --> NIC

    %% Scenario D verdict divergence (software_ok vs hardware_anomaly)
    LinuxPtp -. "Scenario D:<br/>reports SYNCHRONIZED<br/>(software_ok)" .-> CEProxy
    NIC -. "Scenario D:<br/>tx_hwtstamp_timeouts rising<br/>(hardware_anomaly,<br/>Hardware Agent overrides surface signal)" .-> CEProxy
    SRIOV -- "SR-IOV VF allocation<br/>+ hardware tagging" --> NIC
    NFD -- "node labels<br/>(sriov.capable, etc.)" --> Kubelet
    OVNK -- "pod networking" --> Kubelet
    Multus -- "secondary NICs<br/>(DPDK / SR-IOV)" --> VDU

    %% ============== STYLING ==============
    classDef smo fill:#fde8e8,stroke:#c53030,color:#000,stroke-width:3px
    classDef gateway fill:#fef3c7,stroke:#b45309,color:#000,stroke-width:3px
