%% architecture.mmd
%% Macro / billboard view of the O-RAN Agent Harness closed-loop pattern.
%% Seven boxes, two routing branches. The mental map an audience reads in 30 seconds.
%% Companion diagrams (open these for detail):
%%   architecture_zoom_governance.mmd   TM Forum top: audit, reversibility, killswitch, co-authorization
%%   architecture_zoom_cognitive.mmd    Gateway, MCP servers, domain agents, Digital Twin substrate
%%   architecture_zoom_ocloud.mmd       Hub O-Cloud, ACM, spoke operators, worker node, NIC
%%   architecture_full.mmd              Comprehensive 30+ component reference (former architecture v3)

flowchart LR

    Obs["Observation Loop<br/>linuxptp drift<br/>NIC PHC events<br/>cloud-event-proxy<br/>publishes O-RAN CloudEvents"]:::observation

    subgraph Middle["Agent Harness, Intelligence Augmentation"]
        direction TB
        Harness["Agent Harness<br/>Gateway, Domain Agents,<br/>Router, Guardrails,<br/>AuditEvent emission"]:::harness
        Operator["NOC Operator<br/>plus Peer Reviewers"]:::human
        Killswitch["KILLSWITCH<br/>crisis_mode override"]:::killswitch
        Twin["Digital Twin substrate<br/>EvalOps, Sandbox,<br/>Agentic Recoverability"]:::twin
        Harness --> Operator
        Killswitch --> Harness
        Harness --> Twin
    end

    UpRoute["UP route<br/>TMF921 intent<br/>to partner SMO<br/>service-layer actions"]:::routing
    DownRoute["DOWN route<br/>O2 IMS<br/>to O-Cloud Manager<br/>infra-layer actions"]:::routing

    Obs ==> Harness
    Harness ==> UpRoute
    Harness ==> DownRoute

    classDef observation fill:#dbeafe,stroke:#1e40af,color:#000,stroke-width:3px
    classDef harness fill:#fef3c7,stroke:#b45309,color:#000,stroke-width:3px
    classDef human fill:#a7f3d0,stroke:#047857,color:#000,stroke-width:2px
    classDef killswitch fill:#fee2e2,stroke:#991b1b,color:#000,stroke-width:4px
    classDef twin fill:#fff7ed,stroke:#9a3412,color:#000,stroke-width:4px
    classDef routing fill:#fde8e8,stroke:#c53030,color:#000,stroke-width:3px
