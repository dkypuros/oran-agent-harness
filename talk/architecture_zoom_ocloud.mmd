%% architecture_zoom_ocloud.mmd
%% Companion zoom diagram to talk/architecture.mmd (the macro view).
%% Bottom half of the closed-loop system: O-Cloud control plane plus the spoke cluster
%% operators that deliver infra-layer remediations to the worker.
%% Read alongside: talk/architecture.mmd, harness/references/o2ims.md, mco-crd.md, kmm-crd.md.

flowchart TB

    %% Inbound: infra-layer remediation flowing down from the Router
    Inbound["RemediationProposal<br/>(targetLayer: infra,<br/>from architecture_zoom_cognitive.mmd)"]:::external

    subgraph Hub["Red Hat O-Cloud Control Plane (Hub OpenShift Cluster)"]
        direction TB
        O2IMS["O-Cloud Manager<br/>O2 IMS API<br/>(openshift-kni/oran-o2ims,<br/>ref O-RAN.WG6.O2IMS-Interface)"]:::ocloud
        TALM["Topology Aware<br/>Lifecycle Manager (TALM)<br/>ZTP rollout sequencing"]:::hubop
        ArgoCD["OpenShift GitOps<br/>(ArgoCD)"]:::hubop
        ACM["Advanced Cluster Management<br/>(RHACM, multi-cluster)"]:::acm
        Git["Git repository<br/>(ClusterTemplate +<br/>PolicyGenTemplate)"]:::artifact

        O2IMS --> TALM
        O2IMS --> ArgoCD
        TALM --> ACM
        ArgoCD --> Git
        Git --> ACM
    end

    subgraph Spoke["Managed OpenShift Cluster (Cloud RAN Edge Site)"]
        direction TB

        subgraph SpokeOps["Cluster Operators (managed by hub via ACM)"]
            direction LR
            MCO["Machine Config<br/>Operator (MCO)"]:::mco
            KMM["Kernel Module<br/>Management (KMM)"]:::kmm
            PTPOp["PTP Operator"]:::ptpop
            NTO["Node Tuning Operator<br/>(PerformanceProfile,<br/>realtime kernel)"]:::nto
            Metal3["Metal3<br/>(BareMetalHost,<br/>HostFirmwareComponents)"]:::metal3
            SRIOV["SR-IOV Network<br/>Operator"]:::sriov
            NFD["NodeFeatureDiscovery<br/>(NFD)"]:::nfd
        end

        subgraph Worker["worker-ran-XX (RHCOS bare-metal node)"]
            direction TB

            subgraph WorkloadPods["RAN Workload Pods (3GPP / O-RAN)"]
                direction LR
                VDU["O-RAN vDU / gNB-DU<br/>(L1/L2, DPDK + SR-IOV VFs,<br/>consumes PTP TAI)"]:::vdu
                VCU["O-RAN vCU / gNB-CU<br/>(L3)"]:::vdu
                VDU -- "F1 interface<br/>(SCTP / GTP-U)" --> VCU
            end

            subgraph PtpPods["PTP Stack Pods (managed by PTP Operator)"]
                LinuxPtp["linuxptp-daemon pod<br/>ptp4l + phc2sys<br/>(G.8275.1 profile)"]:::daemon
                CEProxy["Cloud Event Proxy<br/>(sidecar,<br/>O-RAN CloudEvents publisher)"]:::proxy
            end

            subgraph HostOS["RHCOS Host OS"]
                Kernel["Linux kernel<br/>(realtime patches optional)"]:::kernel
                Driver["NIC driver<br/>(ice / mlx5_core / iavf)<br/>kernel module"]:::driver
                FwLldp["fw-lldp-agent<br/>(host service,<br/>Scenario A target)"]:::hostsvc
            end

            subgraph Hardware["Bare-metal hardware (NUMA-aware)"]
                NIC["Intel E810 NIC<br/>PHC (PTP Hardware Clock),<br/>SR-IOV capable,<br/>hardware timestamping"]:::hw
                BMC["BMC<br/>(Redfish endpoint,<br/>OOB management)"]:::bmc
            end

            LinuxPtp -- "PHC adjust + timestamping" --> Kernel
            Kernel --> Driver
            FwLldp -. "LLDP TX contention<br/>(fault in Scenario A)" .-> NIC
            Driver --> NIC
        end
    end

    %% Inbound -> Hub
    Inbound ==> O2IMS

    %% Hub -> Spoke policy propagation
    ACM -- "policy propagation" --> MCO
    ACM -- "policy propagation" --> KMM
    ACM -- "policy propagation" --> PTPOp
    ACM -- "policy propagation" --> NTO
    ACM -- "policy propagation" --> Metal3
    ACM -- "policy propagation" --> SRIOV
    ACM -- "policy propagation" --> NFD

    %% Operators deliver to worker
    MCO == "Scenario A:<br/>MachineConfig<br/>(mask fw-lldp-agent.service)" ==> FwLldp
    KMM == "Scenario A-prime:<br/>Module CR<br/>(swap ice 1.11.x to 1.13.7+)" ==> Driver
    PTPOp -- "PtpConfig CR" --> LinuxPtp
    PTPOp -- "deploys sidecar" --> CEProxy
    NTO -- "PerformanceProfile" --> Worker
    Metal3 -- "BMC Redfish" --> BMC
    BMC -- "OOB mgmt" --> NIC
    SRIOV -- "SR-IOV VF allocation" --> NIC
    NFD -- "node labels" --> Worker

    %% Outbound: state notifications back up to the cognitive zoom
    CEProxy == "O-RAN CloudEvents<br/>(WG6 Cloud Notifications)" ==> Outbound["back to<br/>architecture_zoom_cognitive.mmd<br/>(Agentic Gateway)"]:::external

