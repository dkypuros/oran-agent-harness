    classDef llm fill:#e9d5ff,stroke:#6b21a8,color:#000,stroke-width:2px
    classDef llmBackend fill:#ede9fe,stroke:#5b21b6,color:#000
    classDef twin fill:#fff7ed,stroke:#9a3412,color:#000,stroke-width:5px
