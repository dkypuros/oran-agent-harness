%% architecture_zoom_cognitive.mmd v2
%% v2 changes vs v1:
%%   replaced generic LiteLLM node with Unified LLM Inference Client showing the three
%%     providers actually wired in the bench: Anthropic Claude, OpenAI GPT, fake vLLM mock
%%     (OpenShift AI in production)
%%   added ORAN_LLM_MODE env gate annotation (live vs default heuristic fallback)
%%   added Trace JSONL persistence as durable output stream from Router and Agents
%%   added oran-discover OMC bundle as parallel read-only observability surface
%% Companion: trust_loop.md, architecture_narrative.md sections 2 and 4

flowchart TB

    Inbound["O-RAN CloudEvents inbound<br/>from cloud-event-proxy on the worker<br/>(WG6 Cloud Notifications)"]:::external

    subgraph Cognitive["Cognitive components (sit on the Digital Twin substrate below)"]
        direction TB

        subgraph AgenticGateway["Agentic Gateway over MCP"]
            Gateway["Agentic Gateway<br/>mTLS + OAuth2 + IP allowlist<br/>vendor-private tool exposure"]:::gateway
            McpPlat["mcp-platform<br/>ptp4l, services,<br/>driver, NIC stats"]:::mcp
            McpRan["mcp-ran<br/>cell sync, PM counters,<br/>RAN params"]:::mcp
            McpHw["mcp-hardware<br/>NIC PHC, BMC Redfish,<br/>CPU perf counters"]:::mcp
            McpOcloud["mcp-ocloud<br/>O2 IMS Inventory + Alarms,<br/>gated apply"]:::mcp
            Gateway --> McpPlat
            Gateway --> McpRan
            Gateway --> McpHw
            Gateway --> McpOcloud
        end

        subgraph DomainAgents["Domain Agents (LangGraph nodes)"]
            PlatA["Platform Agent"]:::agent
            RanA["RAN Domain Agent"]:::agent
            HwA["Hardware Domain Agent"]:::agent
        end

        KB["Knowledge Base (RAG)<br/>NOC playbooks plus SID context<br/>(maps to TMF GB922)"]:::kb

        subgraph RemediationRouterSection["Remediation Router"]
            RCA["Root Cause Analysis<br/>harness/schemas/RCA.json"]:::artifact
            Taxonomy["taxonomy.yaml<br/>O-RAN WG6 resource model<br/>~20 entries"]:::config
            Router["Remediation Router<br/>deterministic lookup first<br/>LLM-assist on ambiguous edges only"]:::router
            Proposal["RemediationProposal<br/>harness/schemas/RemediationProposal.json"]:::artifact
            RCA --> Router
            Taxonomy -- "lookup" --> Router
            Router --> Proposal
        end

        subgraph LlmClient["Unified LLM Inference Client (env-gated by ORAN_LLM_MODE)"]
            direction LR
            ClientCore["Inference Client<br/>(5G_O-RAN_SIM/llm/client.py)<br/>provider selection by env"]:::llm
            Anthropic["Anthropic Claude<br/>(ANTHROPIC_API_KEY)"]:::llmBackend
            OpenAI["OpenAI GPT<br/>(OPENAI_API_KEY)"]:::llmBackend
            VLLM["vLLM<br/>(OpenShift AI in prod;<br/>fake mock at :8090 in lab)"]:::llmBackend
            ClientCore --> Anthropic
            ClientCore --> OpenAI
            ClientCore --> VLLM
        end

        McpPlat --> PlatA
        McpRan --> RanA
        McpHw --> HwA
        McpOcloud -. "inventory plus alarm context" .-> PlatA
        PlatA --> RCA
        RanA --> RCA
        HwA --> RCA
        KB -. "playbook lookup" .-> PlatA
        KB -. "playbook lookup" .-> RanA
        KB -. "playbook lookup" .-> HwA
        KB -. "SID context" .-> Router
        PlatA -. "LLM reasoning<br/>(only when ORAN_LLM_MODE=live)" .-> ClientCore
        RanA -. "LLM reasoning" .-> ClientCore
        HwA -. "LLM reasoning" .-> ClientCore
        Router -. "LLM-assist<br/>(ambiguous_path only)" .-> ClientCore
    end

    subgraph TwinSubstrate["Digital Twin substrate (the foundation)"]
        direction LR
        EvalOps["EvalOps<br/>continuous measurement<br/>confidence telemetry"]:::activity
        Twin["Digital Twin<br/>same-topology mirrored cluster<br/>or simulated subset<br/>(the substrate underneath the cognitive layer)"]:::twin
        Sandbox["Sandbox<br/>forward-direction test flight<br/>per proposed action"]:::activity
        Recoverability["Agentic Recoverability<br/>inverse action validation<br/>per-action undo (not DR)"]:::activity
        EvalOps -.- Twin
        Twin -.- Sandbox
        Twin -.- Recoverability
    end

    subgraph Persistence["Durable evidence layer (shared_trace JSONL)"]
        Trace["Trace JSONL<br/>5G_O-RAN_SIM/shared_trace/*.jsonl<br/>per-scenario append-only<br/>(rca, proposal, audit, intent)"]:::trace
    end

    subgraph DiscoverBundle["oran-discover OMC bundle (read-only)"]
        Discover["/oran-discover:plan<br/>:ptp :metal3 :redfish<br/>:smo :taxonomy :guardrail<br/>GET only, no mutation"]:::discover
    end

    Inbound ==> Gateway

    %% EvalOps continuous loops up to agents and Router
    EvalOps -. "continuous confidence telemetry" .-> PlatA
    EvalOps -. "continuous confidence telemetry" .-> RanA
    EvalOps -. "continuous confidence telemetry" .-> HwA
    EvalOps -. "confidence floor for ambiguous_path" .-> Router

    %% Sandbox and Recoverability inform the Proposal
    Sandbox ==> Proposal
    Recoverability ==> Proposal

    %% Trace persistence captures every cognitive output
    PlatA -. "append finding" .-> Trace
    RanA -. "append finding" .-> Trace
    HwA -. "append finding" .-> Trace
    Router -. "append routing decision" .-> Trace
    Proposal -. "append proposal" .-> Trace

    %% oran-discover reads (no writes); arrows show data-flow direction
    Trace -. "history served via GET" .-> Discover
    Gateway -. "state served via GET" .-> Discover

    %% Proposal flows outward to the other zooms
    Proposal == "to architecture_zoom_governance.mmd" ==> OutGov["to governance zoom<br/>AuditEvent + Reversibility + Killswitch"]:::external
    Proposal == "to architecture_zoom_ocloud.mmd" ==> OutOcloud["to ocloud zoom<br/>MCO + KMM + Metal3 + NTO"]:::external

