%% architecture_zoom_cognitive.mmd
%% Companion zoom diagram to talk/architecture.mmd (the macro).
%% Double-click on the Agent Harness box of the macro: the Agentic Gateway, four MCP servers,
%% three domain agents, the Remediation Router, the LLM-neutral substrate, all sitting on top
%% of the Digital Twin substrate as their foundation.
%% The twin runs horizontally across the bottom of the diagram. EvalOps is a continuous-loop
%% activity, drawn with dashed bidirectional arrows up to the cognitive components.
%% Sandbox and Agentic Recoverability are actions on the twin that inform the Proposal artifact.
%% Read alongside: talk/trust_loop.md, talk/architecture_narrative.md sections 2 and 4.

flowchart TB

    Inbound["O-RAN CloudEvents inbound<br/>from cloud-event-proxy on the worker<br/>(WG6 Cloud Notifications)"]:::external

    subgraph CognitiveLayer["Cognitive layer (sits on the Digital Twin substrate below)"]
        direction TB

        subgraph GatewayLayer["Agentic Gateway over MCP"]
            Gateway["Agentic Gateway<br/>mTLS + OAuth2 + IP allowlist<br/>vendor-private tool exposure"]:::gateway
            McpPlat["mcp-platform<br/>ptp4l, services,<br/>driver, NIC stats"]:::mcp
            McpRan["mcp-ran<br/>cell sync, PM counters,<br/>RAN params"]:::mcp
            McpHw["mcp-hardware<br/>NIC PHC, BMC Redfish,<br/>CPU perf counters"]:::mcp
            McpOcloud["mcp-ocloud<br/>O2 IMS Inventory + Alarms,<br/>gated apply"]:::mcp
            Gateway --> McpPlat
            Gateway --> McpRan
            Gateway --> McpHw
            Gateway --> McpOcloud
        end

        subgraph AgentLayer["Domain Agents (LangGraph nodes)"]
            PlatA["Platform Agent"]:::agent
            RanA["RAN Domain Agent"]:::agent
            HwA["Hardware Domain Agent"]:::agent
        end

        KB["Knowledge Base (RAG)<br/>NOC playbooks plus SID context<br/>(maps to TMF GB922)"]:::kb

        subgraph RouterLayer["Remediation Router"]
            RCA["Root Cause Analysis<br/>harness/schemas/RCA.json"]:::artifact
            Taxonomy["taxonomy.yaml<br/>O-RAN WG6 resource model<br/>~20 entries"]:::config
            Router["Remediation Router<br/>deterministic lookup first<br/>LLM-assist on ambiguous edges"]:::router
            Proposal["RemediationProposal<br/>harness/schemas/RemediationProposal.json"]:::artifact
            RCA --> Router
            Taxonomy -- "lookup" --> Router
            Router --> Proposal
        end

        LiteLLM["LLM-neutral substrate<br/>LiteLLM-style provider abstraction<br/>OMC routes by model tier"]:::llm

        McpPlat --> PlatA
        McpRan --> RanA
        McpHw --> HwA
        McpOcloud -. "inventory plus alarm context" .-> PlatA
        PlatA --> RCA
        RanA --> RCA
        HwA --> RCA
        KB -. "playbook lookup" .-> PlatA
        KB -. "playbook lookup" .-> RanA
        KB -. "playbook lookup" .-> HwA
        KB -. "SID context" .-> Router
        PlatA -. "LLM reasoning" .-> LiteLLM
        RanA -. "LLM reasoning" .-> LiteLLM
        HwA -. "LLM reasoning" .-> LiteLLM
        Router -. "LLM-assist on ambiguous edges" .-> LiteLLM
    end

    subgraph TwinSubstrate["Digital Twin substrate (the foundation)"]
        direction LR
        EvalOps["EvalOps<br/>continuous measurement<br/>confidence telemetry"]:::activity
        Twin["Digital Twin<br/>same-topology mirrored cluster<br/>or simulated subset<br/>(the substrate underneath the cognitive layer)"]:::twin
        Sandbox["Sandbox<br/>forward-direction test flight<br/>per proposed action"]:::activity
        Recoverability["Agentic Recoverability<br/>inverse action validation<br/>per-action undo (not DR)"]:::activity
        EvalOps -.- Twin
        Twin -.- Sandbox
        Twin -.- Recoverability
    end

    Inbound ==> Gateway

    %% EvalOps continuous loops up to agents and Router
    EvalOps -. "continuous confidence telemetry" .-> PlatA
    EvalOps -. "continuous confidence telemetry" .-> RanA
    EvalOps -. "continuous confidence telemetry" .-> HwA
    EvalOps -. "confidence floor for ambiguous_path" .-> Router

    %% Sandbox and Recoverability inform the Proposal
    Sandbox ==> Proposal
    Recoverability ==> Proposal

    %% Proposal flows outward to the other zooms
    Proposal == "to architecture_zoom_governance.mmd" ==> OutGov["to governance zoom<br/>AuditEvent + Reversibility + Killswitch"]:::external
    Proposal == "to architecture_zoom_ocloud.mmd" ==> OutOcloud["to ocloud zoom<br/>MCO + KMM + Metal3 + NTO"]:::external

    classDef external fill:#f5f5f4,stroke:#44403c,color:#000
    classDef gateway fill:#fef3c7,stroke:#b45309,color:#000,stroke-width:3px
    classDef mcp fill:#fef9c3,stroke:#854d0e,color:#000,stroke-width:2px
    classDef agent fill:#dbeafe,stroke:#1e40af,color:#000,stroke-width:2px
    classDef router fill:#fed7aa,stroke:#c2410c,color:#000,stroke-width:3px
    classDef artifact fill:#fae8ff,stroke:#86198f,color:#000
    classDef config fill:#f3e8ff,stroke:#6b21a8,color:#000
    classDef kb fill:#fff7ed,stroke:#9a3412,color:#000,stroke-width:2px
    classDef llm fill:#e9d5ff,stroke:#6b21a8,color:#000,stroke-width:2px
    classDef twin fill:#fff7ed,stroke:#9a3412,color:#000,stroke-width:5px
    classDef activity fill:#a7f3d0,stroke:#047857,color:#000,stroke-width:2px
