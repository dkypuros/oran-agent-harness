# 5G_O-RAN_SIM LLM inference configuration
# Copy this file to .env and edit the values for real provider keys.
# .env is gitignored at the repo root; .env.example is committed as a template.

# ---- Anthropic Claude (production cloud LLM) ----
ANTHROPIC_API_KEY=stub-replace-with-real-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_HIGH=claude-opus-4-7
ANTHROPIC_MODEL_MEDIUM=claude-sonnet-4-6
ANTHROPIC_MODEL_LOW=claude-haiku-4-5

# ---- OpenAI GPT (alternative production cloud LLM) ----
OPENAI_API_KEY=stub-replace-with-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_HIGH=gpt-4o
OPENAI_MODEL_MEDIUM=gpt-4o-mini
OPENAI_MODEL_LOW=gpt-4o-mini

# ---- OpenShift AI vLLM (on-prem OpenAI-compatible endpoint) ----
# Example: https://vllm-your-namespace.apps.example.com/v1
VLLM_API_KEY=
VLLM_BASE_URL=
VLLM_MODEL_HIGH=granite-7b-instruct
VLLM_MODEL_MEDIUM=llama-3-8b-instruct
VLLM_MODEL_LOW=mistral-7b-instruct

# ---- Provider routing ----
# Which provider the LLM client uses by default.
# Values: anthropic | openai | vllm
LLM_PROVIDER=anthropic
