root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yaml,yml,json}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

[*.mmd]
indent_size = 2
