FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.30.6 \
    httpx==0.27.2 \
    pydantic==2.9.2 \
    anthropic==0.39.0

COPY omc-skills /app/omc-skills
COPY harness /app/harness
COPY scenarios /app/scenarios
COPY 5G_O-RAN_SIM /app/5G_O-RAN_SIM
COPY docs /app/docs
COPY macbook_lab/http_wrappers/harness_chat_service.py /app/harness_chat_service.py

ENV PYTHONUNBUFFERED=1
ENV PORT=8098
EXPOSE 8098

CMD ["python", "/app/harness_chat_service.py"]
