# MacBook lab .env template. Copy to .env and edit.
# The dashboard chat service uses Anthropic. The harness walker's ambiguous-path
# LLM seam is provider-neutral: Anthropic, OpenAI API, or an OpenAI-compatible
# on-prem vLLM endpoint such as Red Hat OpenShift AI.

ANTHROPIC_API_KEY=stub-replace-with-real-key
OPENAI_API_KEY=stub-replace-with-real-key
VLLM_API_KEY=

ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
VLLM_BASE_URL=

ANTHROPIC_MODEL_HIGH=claude-opus-4-7
ANTHROPIC_MODEL_MEDIUM=claude-sonnet-4-6
ANTHROPIC_MODEL_LOW=claude-haiku-4-5
OPENAI_MODEL_HIGH=gpt-4o
OPENAI_MODEL_MEDIUM=gpt-4o-mini
OPENAI_MODEL_LOW=gpt-4o-mini
VLLM_MODEL_HIGH=granite-7b-instruct
VLLM_MODEL_MEDIUM=llama-3-8b-instruct
VLLM_MODEL_LOW=mistral-7b-instruct

# Which provider the harness Router uses for ambiguous_path disambiguation when
# ORAN_LLM_MODE=live is set. Values: anthropic | openai | vllm
LLM_PROVIDER=anthropic
ORAN_LLM_MODE=heuristic
